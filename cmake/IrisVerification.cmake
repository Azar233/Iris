# Keep established CMake target/API names while branding executable artifacts.
get_property(iris_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
set(iris_executable_map "{\n")
set(iris_map_separator "")
foreach(iris_target IN LISTS iris_targets)
    get_target_property(iris_type ${iris_target} TYPE)
    if(NOT iris_type STREQUAL "EXECUTABLE")
        continue()
    endif()
    get_target_property(iris_output ${iris_target} OUTPUT_NAME)
    if(NOT iris_output)
        string(REGEX REPLACE "^MyRenderer" "Iris" iris_output "${iris_target}")
        set_target_properties(${iris_target} PROPERTIES OUTPUT_NAME "${iris_output}")
    endif()
    string(APPEND iris_executable_map "${iris_map_separator}  \"${iris_output}\": \"${iris_target}\"")
    set(iris_map_separator ",\n")
endforeach()
string(APPEND iris_executable_map "\n}\n")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/iris-executable-targets.json" CONTENT "${iris_executable_map}")
get_property(iris_owner_records GLOBAL PROPERTY IRIS_TEST_OWNERS)
set(iris_owner_json "{\n")
set(iris_separator "")
foreach(iris_record IN LISTS iris_owner_records)
    string(REPLACE "|" ";" iris_record_parts "${iris_record}")
    list(GET iris_record_parts 0 iris_test_name)
    list(GET iris_record_parts 1 iris_test_owners)
    string(REPLACE "," "\", \"" iris_test_owners "${iris_test_owners}")
    string(APPEND iris_owner_json "${iris_separator}  \"${iris_test_name}\": [\"${iris_test_owners}\"]")
    set(iris_separator ",\n")
endforeach()
string(APPEND iris_owner_json "\n}\n")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/iris-test-targets.json" CONTENT "${iris_owner_json}")
if(BUILD_TESTING)
    get_property(iris_tests DIRECTORY PROPERTY TESTS)
    foreach(iris_test IN LISTS iris_tests)
        set(iris_label core)
        if(iris_test MATCHES "^physics-")
            set(iris_label physics)
        elseif(iris_test MATCHES "^render-plugin")
            set(iris_label plugins)
        elseif(iris_test MATCHES "shader-scene")
            set(iris_label shader-scene)
        elseif(iris_test MATCHES "scene-|camera-navigation")
            set(iris_label scene)
        elseif(iris_test MATCHES "^workspace-assets$|^workspace-shader-package$|^workspace-file-actions$|^asset-import$|^asset-thumbnails$")
            set(iris_label assets)
        elseif(iris_test MATCHES "render-job|render-queue|batch-output|raster-capture")
            set(iris_label jobs)
        elseif(iris_test MATCHES "path-tracing|cpu-progressive")
            set(iris_label path-tracing)
        elseif(iris_test MATCHES "cloud|water|atmosphere|shadow|prism")
            set(iris_label optics)
        elseif(iris_test MATCHES "state-paths")
            set(iris_label state)
        endif()
        set_tests_properties(${iris_test} PROPERTIES LABELS "${iris_label}")
    endforeach()
endif()
